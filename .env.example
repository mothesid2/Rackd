# Rackd environment configuration
# Copy this file to ".env" and fill in real values. ".env" is gitignored.
#
# These are read by the MAIN process only (src/main/supabase/*). The Supabase
# client is never exposed to the renderer. Leave these blank to run the app
# fully local — the cloud sync worker stays dormant until both are set.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase anon/public key (safe for client use; protected by Row Level Security)
SUPABASE_ANON_KEY=
