# Rackd environment configuration
# Copy this file to ".env" and fill in real values. ".env" is gitignored.
#
# These are read by the MAIN process only (src/main/supabase/*). The Supabase
# client is never exposed to the renderer. Leave these blank to run the app
# fully local — the cloud sync worker stays dormant until both are set.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://zougcsomgqnfumqkwuoj.supabase.co

# Supabase anon/public key (safe for client use; protected by Row Level Security)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpvdWdjc29tZ3FuZnVtcWt3dW9qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE4OTg0NDgsImV4cCI6MjA5NzQ3NDQ0OH0.71u1D-lfjDDNllg_pRj8hoqcq1vP2tGhFQ624XUoVrs

# Demo build flag (owner only). Set DEMO_MODE=1 to expose the Owner Console in
# Settings (customer-display/ads config + owner PIN reset). Leave unset/absent on
# client installs so the Owner Console stays hidden.
# DEMO_MODE=1

# Anthropic API key — powers the AI features (RACKD_SYSTEM_PROMPT). Read only in
# the main process; never shipped to the renderer. Leave unset to run without AI.
# SECURITY: do not embed a real key in client builds — proxy AI calls through your
# own backend in production. .env is gitignored and not packaged.
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Onboarding (r4ckd.net /get-started) and hardware store (/hardware)
# Server-side values live as Cloudflare Pages secrets (and Supabase function
# secrets where noted). NEVER prefix secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Risky features: all default to false. Flip only after the matching setup is done.
STRIPE_LIVE_ENABLED=false          # false = Stripe TEST mode + visible test notice
PAYMENT_PROCESSOR_CONNECTED=false  # false = owner KYC step is a placeholder (no DOB/SSN collected)
SMS_ENABLED=false                  # false = Twilio never called

# Supabase (server only, Pages Functions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the business EIN at rest.
# Losing this key makes stored EINs unrecoverable; rotating needs a re-encrypt job.
EIN_ENCRYPTION_KEY=

# Cloudflare Turnstile. Dev defaults below are Cloudflare's published always-pass test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend (dev: Resend's shared test sender until r4ckd.net is verified there)
RESEND_API_KEY=
RESEND_FROM=Rackd <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=

# Public site origin used in emailed links (resume link, order links)
APP_BASE_URL=https://r4ckd.net

# Stripe, Rackd's OWN charges only (hardware + software fees). Never vape/tobacco payments.
# Confirm Stripe's restricted-business policy before STRIPE_LIVE_ENABLED=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional virus-scan hook for uploaded documents (stubbed: marks files 'skipped' when unset)
DOC_SCAN_HOOK_URL=

# Browser-side Supabase (anon key is safe to expose; anon has no table access to onboarding data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Salt for hashing client IPs into rate-limit buckets (any long random string). Server only.
IP_HASH_SALT=
