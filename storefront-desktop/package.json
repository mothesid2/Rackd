{
  "name": "rackd-storefront-desktop",
  "version": "1.0.0",
  "description": "Rackd Storefront desktop wrapper — a thin shell around the deployed web storefront, mainly for demoing to prospects.",
  "main": "main.js",
  "author": "Rackd",
  "scripts": {
    "start": "electron .",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^41.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rackd.storefront",
    "productName": "Rackd Storefront",
    "npmRebuild": false,
    "directories": { "output": "dist" },
    "files": ["main.js", "config.js", "assets/**/*"],
    "win": { "target": "nsis", "icon": "assets/logo.png" },
    "mac": { "target": "dmg", "icon": "assets/logo.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Rackd-Storefront-Setup-${version}.${ext}",
      "shortcutName": "Rackd Storefront"
    }
  }
}
