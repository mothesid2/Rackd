{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@sfm/*": [
        "../packages/storefront-admin/src/*"
      ],
      "react": [
        "../packages/storefront-admin/node_modules/@types/react"
      ],
      "react/*": [
        "../packages/storefront-admin/node_modules/@types/react/*"
      ],
      "react-dom/client": [
        "../packages/storefront-admin/node_modules/@types/react-dom/client"
      ],
      "@supabase/supabase-js": [
        "../packages/storefront-admin/node_modules/@supabase/supabase-js"
      ]
    }
  },
  "include": [
    "src"
  ]
}