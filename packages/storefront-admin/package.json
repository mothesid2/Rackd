{
  "name": "@rackd/storefront-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Storefront Manager: one React module mounted by manage.r4ckd.net, the Manager Portal and the Owner Console.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/styles.css -o dist/storefront-admin.css --minify",
    "build:js": "node build.mjs",
    "build": "npm run build:js && npm run build:css"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^4.1.0",
    "jsdom": "^26.0.0",
    "@testing-library/react": "^16.0.0"
  }
}
