{
  "name": "rackd-owner-console",
  "version": "1.0.5",
  "description": "Rackd Owner Console — private cockpit: provisioning, kiosks, online orders, and publishing updates.",
  "main": "main.js",
  "author": "Rackd",
  "scripts": {
    "start": "electron .",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:mac": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "release:staging": "npm run dist && node ../scripts/publish-update.js staging owner dist",
    "release": "npm run dist && node ../scripts/publish-update.js production owner dist"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^41.10.2",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rackd.owner",
    "productName": "Rackd Owner Console",
    "npmRebuild": false,
    "publish": {
      "provider": "generic",
      "url": "https://zougcsomgqnfumqkwuoj.supabase.co/storage/v1/object/public/app-updates/owner/production"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Rackd-Owner-Console-Setup-${version}.${ext}",
      "shortcutName": "Rackd Owner Console"
    }
  }
}
